{
  // @config-manager:start knip
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "rules": {
    "binaries": "error",
    "catalog": "error",
    "dependencies": "error",
    "duplicates": "error",
    "enumMembers": "error",
    "exports": "error",
    "namespaceMembers": "error",
    "types": "error",
    "unlisted": "error",
    "unresolved": "error",
  },
  "tags": [
    "-lintignore"
  ],
  // @config-manager:end knip
  "project": [
    "assets/**/*.js",
    "assets/**/*.jsx",
    "assets/**/*.ts",
    "assets/**/*.tsx",
  ],
}
